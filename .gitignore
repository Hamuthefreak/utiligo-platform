# Secrets & local config — never commit
/storage/config_overrides.php
/.env
*.log
# Runtime lead-workspace log (LEADS_LOG_PATH in includes/leads_logger.php).
# Written while the app runs, including during a test run.
/storage/leads_log.txt

# The canary the "Write test file" button on admin/settings.php drops into storage/ to
# prove the folder it saves to is the folder being looked at. Inert and safe to delete;
# it is written while the app runs, including from a local press of that button.
/storage/_utiligo_write_test.php

# Support attachments (SUPPORT_UPLOAD_DIR_REL in includes/support.php). These are
# customers' screenshots and documents, written while the app runs: they belong to
# the people who uploaded them, not to the repository. storage/.htaccess denies
# direct access, and api/support-file.php is the only reader.
/storage/support/

# Build artifacts
/Utiligo.zip
/UTILIGO.zip

# Test-run scratch: sessions, Stripe stub fixtures, captured requests, logs.
# The suite recreates all of it on every run, so nothing here is worth keeping.
/tests/tmp/
