RewriteEngine On

# ---------------------------------------------------------------
# CUSTOM ERROR PAGES
# ---------------------------------------------------------------
ErrorDocument 400 /notfound/400.php
ErrorDocument 401 /notfound/401.php
ErrorDocument 403 /notfound/403.php
ErrorDocument 404 /notfound/404.php
ErrorDocument 500 /notfound/500.php
ErrorDocument 503 /notfound/503.php

# ---------------------------------------------------------------
# ROUTING
# ---------------------------------------------------------------

# Public shareable site links: /s/{slug}
RewriteRule ^s/([a-zA-Z0-9\-]+)/?$ s.php?slug=$1 [L,QSA]

# SEO routes: sitemap.xml (dynamic), /blog/{slug}, /leads/{city}/{industry}
RewriteRule ^sitemap\.xml$                                sitemap.php                                    [L,QSA]
RewriteRule ^blog/([a-zA-Z0-9\-]+)/?$                     blog.php?slug=$1                               [L,QSA]
RewriteRule ^leads/([a-z0-9\-]+)/([a-z0-9\-]+)/?$         leads.php?city=$1&industry=$2                  [L,QSA]

# Mark app / preview paths as noindex (used by the X-Robots-Tag header below)
RewriteRule ^(s|portal|admin|api)(/|$) - [E=UTL_NOINDEX:1]

# ---------------------------------------------------------------
# CLEAN URLs — strip .php extension
# Exclude: api/, notfound/ (error pages must never be 301'd)
# ---------------------------------------------------------------

# 1. Redirect /page.php -> /page (301)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteCond %{REQUEST_URI} !^/notfound/ [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Admin pages: /admin/page -> admin/page.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/([a-zA-Z0-9_\-]+)/?$ admin/$1.php [L,QSA]

# 3. Portal pages: /portal/page -> portal/page.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^portal/([a-zA-Z0-9_\-]+)/?$ portal/$1.php [L,QSA]

# 4. Root pages: /page -> page.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_\-]+)/?$ $1.php [L,QSA]

# ---------------------------------------------------------------
# BLOCK SENSITIVE PATHS
# ---------------------------------------------------------------
RewriteRule ^storage/    - [F,L]
RewriteRule ^db/         - [F,L]
RewriteRule ^sql/        - [F,L]
RewriteRule ^migrations/ - [F,L]
RewriteRule ^includes/   - [F,L]

<FilesMatch "^(config|db|userdb)\.php$">
    Require all denied
</FilesMatch>
# Block sensitive file types. NOT ".zip" — user-generated site exports
# are served from /exports/*.zip (api/generate-site.php), and blocking
# *.zip globally would 403 every legitimate ZIP download.
<FilesMatch "\.(sql|sh|env|log|bak|ini)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------
# SECURITY HEADERS
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cache-Control "no-store, no-cache, must-revalidate" env=IS_PORTAL
    Header always set X-Robots-Tag "noindex, nofollow" env=UTL_NOINDEX
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://js.stripe.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self'; connect-src 'self' https://api.brevo.com https://api.stripe.com https://www.googletagmanager.com https://www.google-analytics.com; object-src 'none'; base-uri 'self';"
    Header always unset X-Powered-By
</IfModule>

ServerSignature Off
# php_value only works under mod_php; wrap it so PHP-FPM/CGI/FastCGI
# hosts (InfinityFree and most modern setups) don't 500 the whole site.
<IfModule mod_php.c>
    php_value display_errors On
</IfModule>

# ---------------------------------------------------------------
# PERFORMANCE — gzip + asset caching (safe if modules are absent)
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>
